{{/* chezmoi:template:missing-key=zero */}}
# Machine-specific configuration template
# Prompts during `chezmoi init` and saves answers to ~/.config/chezmoi/chezmoi.toml

{{- $email := promptStringOnce . "email" "Git email address" "anton.eriksmo@gmail.com" -}}
{{- $name := promptStringOnce . "name" "Git user name" "Anton Eriksmo" -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
